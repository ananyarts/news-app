# Copy this file to .env and fill in your own values.
# .env is git-ignored, so secrets never get committed.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database: "mariadb" (default) or "sqlite" for quick local runs.
DB_ENGINE=mariadb
DB_NAME=news_app
DB_USER=news_user
DB_PASSWORD=news_pass
DB_HOST=127.0.0.1
DB_PORT=3306

DEFAULT_FROM_EMAIL=newsroom@news-app.local

# Internal endpoint the approval flow POSTs to.
APPROVED_API_URL=http://127.0.0.1:8000/api/approved/
APPROVED_API_TIMEOUT=5
